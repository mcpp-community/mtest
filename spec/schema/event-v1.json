{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/mcpp-community/mtest/spec/schema/event-v1.json",
 "title": "mtest protocol event, version 1 (spec/protocol.md P5)",
 "type": "object",
 "required": [
  "e"
 ],
 "properties": {
  "e": {
   "type": "string"
  }
 },
 "oneOf": [
  {
   "properties": {
    "e": {
     "const": "program"
    },
    "protocol": {
     "const": 1
    },
    "level": {
     "enum": [
      1,
      2,
      3
     ]
    },
    "framework": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "isolation": {
     "type": "array",
     "items": {
      "enum": [
       "process",
       "case"
      ]
     }
    },
    "guide": {
     "type": "string",
     "description": "P2.5: a URL of the framework's guide to writing tests"
    }
   },
   "required": [
    "e",
    "protocol",
    "level"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "case"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string"
    },
    "file": {
     "type": "string"
    },
    "line": {
     "type": "integer",
     "minimum": 0
    },
    "kind": {
     "enum": [
      "unit",
      "e2e",
      "cts",
      "bench"
     ]
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "clauses": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "expect": {
     "enum": [
      "pass",
      "fail",
      "skip"
     ]
    },
    "resources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "artifacts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "timeout": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "P3.3: seconds the case may run"
    },
    "isolation": {
     "const": "case",
     "description": "P3.3: the case runs in a process of its own"
    },
    "retries": {
     "type": "integer",
     "minimum": 0,
     "description": "P3.3: how many times a failing case runs again, alone"
    },
    "diagnose": {
     "type": "object",
     "description": "P3.3: what a runner does after the case fails",
     "properties": {
      "env": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      },
      "timeout": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     }
    },
    "bounds": {
     "type": "array",
     "description": "P6.5: limits on the case's metrics",
     "items": {
      "type": "object",
      "required": [
       "metric"
      ],
      "properties": {
       "metric": {
        "type": "string"
       },
       "max": {
        "type": "number"
       },
       "min": {
        "type": "number"
       }
      }
     }
    },
    "uses": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "P11.2: the run fixtures the case uses"
    },
    "reason": {
     "type": "string",
     "description": "why the program lists the case skipped (expect skip)"
    },
    "only": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "0.8.0: the platforms and architectures the case runs only on"
    },
    "except": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "0.8.0: the platforms and architectures the case does not run on"
    },
    "capabilities": {
     "type": "object",
     "additionalProperties": {
      "type": "boolean"
     },
     "description": "0.8.0: the capabilities the case requires, as its program answered them"
    }
   },
   "required": [
    "e",
    "id"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "begin"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "t": {
     "type": "number",
     "minimum": 0
    },
    "kind": {
     "enum": [
      "unit",
      "e2e",
      "cts",
      "bench"
     ]
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "clauses": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "bounds": {
     "type": "array",
     "description": "P6.5: limits on the case's metrics",
     "items": {
      "type": "object",
      "required": [
       "metric"
      ],
      "properties": {
       "metric": {
        "type": "string"
       },
       "max": {
        "type": "number"
       },
       "min": {
        "type": "number"
       }
      }
     }
    }
   },
   "required": [
    "e",
    "id"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "failure"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "file": {
     "type": "string"
    },
    "line": {
     "type": "integer",
     "minimum": 0
    },
    "message": {
     "type": "string"
    },
    "expected": {
     "type": "string"
    },
    "actual": {
     "type": "string"
    },
    "fatal": {
     "type": "boolean"
    }
   },
   "required": [
    "e",
    "id",
    "message"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "output"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "stream": {
     "enum": [
      "out",
      "err"
     ]
    },
    "text": {
     "type": "string"
    }
   },
   "required": [
    "e",
    "id",
    "stream",
    "text"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "metric"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "value": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "samples": {
     "type": "array",
     "items": {
      "type": "number"
     }
    },
    "better": {
     "enum": [
      "lower",
      "higher"
     ]
    },
    "precision": {
     "enum": [
      "exact",
      "process",
      "approx",
      "sampled"
     ],
     "description": "P6.6"
    }
   },
   "required": [
    "e",
    "id",
    "name",
    "value",
    "unit"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "artifact"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "path": {
     "type": "string"
    },
    "kind": {
     "type": "string"
    }
   },
   "required": [
    "e",
    "id",
    "path"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "end"
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "status": {
     "enum": [
      "pass",
      "fail",
      "skip",
      "xfail",
      "xpass",
      "invalid"
     ]
    },
    "ms": {
     "type": "number",
     "minimum": 0
    },
    "reason": {
     "type": "string"
    }
   },
   "required": [
    "e",
    "id",
    "status"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "missing"
    },
    "id": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "e",
    "id"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "done"
    },
    "status": {
     "enum": [
      "pass",
      "fail"
     ]
    },
    "counts": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "required": [
    "e",
    "status"
   ]
  },
  {
   "properties": {
    "e": {
     "const": "fixture"
    },
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "ms": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "e",
    "id",
    "ms"
   ],
   "description": "P5.2: a shared object a case caused to be made, and how long making it took"
  },
  {
   "properties": {
    "e": {
     "not": {
      "enum": [
       "program",
       "case",
       "begin",
       "failure",
       "output",
       "metric",
       "artifact",
       "end",
       "missing",
       "done",
       "fixture"
      ]
     }
    }
   },
   "description": "P5.4: an unknown kind is ignored"
  },
  {
   "properties": {
    "e": {
     "const": "usage"
    },
    "user_ms": {
     "type": "number",
     "minimum": 0
    },
    "sys_ms": {
     "type": "number",
     "minimum": 0
    },
    "peak_bytes": {
     "type": "number",
     "minimum": 0
    },
    "read_bytes": {
     "type": "number",
     "minimum": 0
    },
    "written_bytes": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "e",
    "user_ms",
    "sys_ms"
   ],
   "description": "P10.2: the program's own use at its end"
  },
  {
   "properties": {
    "e": {
     "const": "component"
    },
    "name": {
     "type": "string"
    },
    "pools": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "capacity": {
        "type": "integer",
        "minimum": 1
       }
      },
      "required": [
       "name",
       "capacity"
      ]
     }
    },
    "fixture": {
     "type": "string"
    },
    "scope": {
     "const": "run"
    }
   },
   "required": [
    "e"
   ],
   "description": "P11.1: a component, or a run fixture the program serves"
  }
 ]
}
